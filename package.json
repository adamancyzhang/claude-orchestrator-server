{
  "name": "@adamancyzhang/claude-orchestrator",
  "version": "0.7.0",
  "private": true,
  "description": "Multi-agent orchestration CLI backed by ZooKeeper — register, assign tasks, communicate, share context",
  "repository": "github:adamancyzhang/claude-orchestrator-server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-orchestrator": "bin/claude-orchestrator"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "depcheck": "depcruise --config .dependency-cruiser.cjs packages",
    "pkgcheck": "node scripts/check-pkg-deps.mjs",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:watch": "pnpm --filter './packages/*' test:watch"
  },
  "files": [
    "packages/*/dist/",
    "bin/claude-orchestrator"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "dependency-cruiser": "^16.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
